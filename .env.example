# Copia este archivo como .env y completa los valores (no se commitea).
# Angular no lee .env directamente: `scripts/write-env.mjs` (se ejecuta en pnpm start/build/test)
# genera src/environments/env.generated.ts. En CI/Docker se pasan como variables de entorno.

# Microsoft Entra ID: Application (client) ID del registro SPA.
NG_APP_ENTRA_CLIENT_ID=
# Directory (tenant) ID.
NG_APP_ENTRA_TENANT_ID=
# Application ID URI de la API, sin scope ni barra final (ej. api://<id>).
NG_APP_API_SCOPE_BASE=

# API Gateway HTTP (producción). Vacío = mismo origen (pnpm start:local usa el proxy de Angular).
NG_APP_API_BASE_URL=
# API Gateway WebSocket de telemetría (wss://<id>.execute-api.<region>.amazonaws.com/<stage>).
# Vacío = el dashboard consulta GET /api/v1/analytics/metricas cada 5 s.
NG_APP_TELEMETRIA_WS_URL=
