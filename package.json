{
  "name": "camisetas360-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/write-env.mjs && ng serve",
    "build": "node scripts/write-env.mjs && ng build",
    "watch": "node scripts/write-env.mjs && ng build --watch --configuration development",
    "test": "node scripts/write-env.mjs && ng test --watch=false",
    "start:local": "node scripts/write-env.mjs && ng serve --configuration local",
    "test:watch": "node scripts/write-env.mjs && ng test",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "e2e": "playwright test --project=e2e",
    "env:write": "node scripts/write-env.mjs",
    "test:coverage": "node scripts/write-env.mjs && ng test --watch=false --coverage",
    "e2e:rendimiento": "playwright test --project=rendimiento",
    "e2e:backend": "playwright test --project=e2e --grep @backend"
  },
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@azure/msal-angular": "^6.2.0",
    "@azure/msal-browser": "^5.20.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@stomp/stompjs": "7.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^28.0.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
